# Runtime: OFF | SHADOW | PAPER | LIVE
TRADING_MODE=OFF
LIVE_ARMED=false
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
KITE_AUTH_ENABLED=false

# API and application
API_HOST=0.0.0.0
API_PORT=8000
APP_JWT_SECRET=replace-through-secret-manager
OPERATOR_AUTH_TOKEN=

# Database / Redis
DATABASE_URL=postgresql+asyncpg://trader:change-me@postgres:5432/trader
REDIS_URL=redis://:change-me@redis:6379/0

# Kite auth — supply from Secret Manager in deployed environment
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=
KITE_SESSION_ENCRYPTION_KEY=
KITE_ACCESS_TOKEN_STORAGE_MODE=database_encrypted

# P04 market data ingestion defaults remain disabled
MARKET_DATA_ENABLED=false
INSTRUMENT_SYNC_ENABLED=false
KITE_WEBSOCKET_ENABLED=false
MARKET_DATA_WATCHLIST=NSE:NIFTYBEES,NSE:SBIN
MARKET_DATA_WATCHLIST_FILE=
MARKET_DATA_MODE=quote
MARKET_DATA_MAX_INSTRUMENTS=10
MARKET_DATA_STALE_AFTER_SECONDS=10
MARKET_DATA_CANDLE_INTERVAL=1minute

# P05 deterministic scanner defaults remain disabled
SCANNER_ENABLED=false
SCANNER_STRATEGIES=opening_range_breakout_long,vwap_pullback_continuation_long
SCANNER_OBSERVATION_MODE=SHADOW
SCANNER_FUTURE_LIVE_ELIGIBLE_STRATEGY=opening_range_breakout_long
SCANNER_OPENING_RANGE_MINUTES=15
SCANNER_STALE_AFTER_SECONDS=10
SCANNER_MIN_VOLUME_RATIO=1.5
SCANNER_MAX_SPREAD_PCT=0.20
SCANNER_REQUIRE_SPREAD_FOR_FUTURE_LIVE=true
SCANNER_BENCHMARK_SYMBOL=
SCANNER_AUTO_LOOP_ENABLED=false
SCANNER_AUTO_LOOP_INTERVAL_SECONDS=300
SCANNER_AUTO_LOOP_SYMBOLS=
SCANNER_AUTO_LOOP_USE_MARKET_WATCHLIST=true
SCANNER_AUTO_LOOP_STORE_REJECTIONS=false
SCANNER_AUTO_LOOP_MAX_SYMBOLS=20
SCANNER_AUTO_LOOP_TIMEFRAME=1minute
SCANNER_AUTO_LOOP_START_AFTER_IST=10:07
SCANNER_AUTO_LOOP_STOP_AFTER_IST=15:00
SCANNER_AUTO_LOOP_RUN_ON_MARKET_DAYS_ONLY=false
SCANNER_AUTO_LOOP_MIN_CANDLES=51
SCANNER_AUTO_LOOP_REQUIRE_SESSION_START=true
SCANNER_AUTO_LOOP_REQUIRE_CONTINUITY=true
SCANNER_AUTO_LOOP_SUPPRESS_DUPLICATE_REJECTIONS=true
SCANNER_AUTO_LOOP_CANDIDATES_ALWAYS_PERSIST=true
SCANNER_AUTO_LOOP_USE_SELECTED_UNIVERSE=false

# P05.8 deterministic universe selection defaults remain disabled
UNIVERSE_SELECTION_ENABLED=false
UNIVERSE_SELECTION_POOL=
UNIVERSE_SELECTION_POOL_FILE=
UNIVERSE_SELECTION_MAX_POOL_SYMBOLS=100
UNIVERSE_SELECTION_OUTPUT_LIMIT=20
UNIVERSE_SELECTION_TIMEFRAME=1minute
UNIVERSE_SELECTION_MIN_SESSION_CANDLES=51
UNIVERSE_SELECTION_LOOKBACK_DAYS=5
UNIVERSE_SELECTION_REQUIRE_ACTIVE_INSTRUMENT=true
UNIVERSE_SELECTION_REQUIRE_CONTINUITY=true
UNIVERSE_SELECTION_BENCHMARK_SYMBOL=NSE:NIFTYBEES
UNIVERSE_SELECTION_MIN_PRICE=20
UNIVERSE_SELECTION_MAX_PRICE=10000
UNIVERSE_SELECTION_MIN_AVG_TURNOVER=0
UNIVERSE_SELECTION_MIN_ATR_PCT=0
UNIVERSE_SELECTION_MAX_ATR_PCT=10
UNIVERSE_SELECTION_EXCLUDE_SPECIAL_CHAR_SYMBOLS=true
UNIVERSE_SELECTION_STORE_RUNS=true
UNIVERSE_SELECTION_USE_LATEST_FOR_SCANNER_BATCH=false
UNIVERSE_SELECTION_STALE_POLICY=exclude

# P05.9 market operations and notifications remain disabled by default
MARKET_OPS_AUTOMATION_ENABLED=false
MARKET_OPS_NOTIFY_ENABLED=false
MARKET_OPS_NOTIFY_PROVIDER=none
MARKET_OPS_TELEGRAM_BOT_TOKEN=
MARKET_OPS_TELEGRAM_CHAT_ID=
MARKET_OPS_NOTIFY_MIN_LEVEL=warning
MARKET_OPS_TIMEZONE=Asia/Kolkata
MARKET_OPS_PREOPEN_CHECK_TIME=08:55
MARKET_OPS_STREAM_START_TIME=09:08
MARKET_OPS_STREAM_VERIFY_TIME=09:16
MARKET_OPS_UNIVERSE_SELECT_TIME=10:07
MARKET_OPS_SCANNER_START_TIME=10:08
MARKET_OPS_SCANNER_INTERVAL_SECONDS=300
MARKET_OPS_SCANNER_STOP_TIME=15:00
MARKET_OPS_STREAM_STOP_TIME=15:31
MARKET_OPS_REQUIRE_KITE_SESSION=true
MARKET_OPS_REQUIRE_WATCHLIST_READY=true
MARKET_OPS_REQUIRE_STREAM_CONNECTED=true
MARKET_OPS_REQUIRE_MIN_CANDLES_FOR_UNIVERSE=51
MARKET_OPS_USE_UNIVERSE_SELECTION=true
MARKET_OPS_USE_SELECTED_UNIVERSE_FOR_SCANNER=true
MARKET_OPS_STORE_REJECTIONS=false
MARKET_OPS_DRY_RUN=false

# P06 paper trading defaults remain disabled and simulated-only
PAPER_ENABLED=false
PAPER_MODE=OFF
PAPER_MAX_TRADES_PER_DAY=3
PAPER_DEFAULT_QUANTITY=1
PAPER_ENTRY_BUFFER_PCT=0
PAPER_STOP_PCT=0.50
PAPER_TARGET_R_MULTIPLE=2.0
PAPER_FORCE_FLAT_TIME_IST=15:10
PAPER_ESTIMATED_COST_PER_TRADE=0

# OpenAI — not used until plan P07
OPENAI_API_KEY=
OPENAI_MODEL=

# Risk defaults; deployed live values require manual review
CAPITAL_ALLOCATION_INR=2000
MAX_TRADE_NOTIONAL_INR=500
MAX_PLANNED_RISK_PER_TRADE_INR=10
MAX_DAILY_LOSS_INR=20
MAX_TRADES_PER_DAY=1
MAX_OPEN_POSITIONS=1
MIN_CASH_RESERVE_INR=1000
ENTRY_CUTOFF_IST=14:30
FORCE_FLAT_IST=15:10
